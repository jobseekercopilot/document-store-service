# Production values are supplied by the approved secret and infrastructure
# boundary. Never commit real credentials, document content, keys or tokens.
DOCUMENT_STORE_DATABASE_URL=jdbc:postgresql://database.example:5432/document_store
DOCUMENT_STORE_DATABASE_USERNAME=document_store
DOCUMENT_STORE_DATABASE_PASSWORD=replace-via-secret-injection
DOCUMENT_STORE_DATABASE_SSL_MODE=verify-full
DOCUMENT_STORE_ENCRYPTION_AT_REST_ENABLED=true
DOCUMENT_STORE_ENCRYPTION_KEY_REFERENCE=kms://replace-with-managed-database-key-reference
DOCUMENT_STORE_BACKUP_ENCRYPTION_ENABLED=true
DOCUMENT_STORE_BACKUP_KEY_REFERENCE=kms://replace-with-managed-backup-key-reference
DOCUMENT_STORE_OBJECT_PROVIDER=s3
# The AWS public-beta path uses only the ECS task-role credential endpoint.
DOCUMENT_STORE_OBJECT_CREDENTIALS_PROVIDER=task-role
# Leave endpoint and static keys unset in task-role mode. Approved compatible
# stores must explicitly select static mode and an HTTPS endpoint instead.
DOCUMENT_STORE_OBJECT_ENDPOINT=
DOCUMENT_STORE_OBJECT_REGION=eu-west-2
DOCUMENT_STORE_OBJECT_BUCKET=job-seeker-copilot-documents
DOCUMENT_STORE_OBJECT_ACCESS_KEY=
DOCUMENT_STORE_OBJECT_SECRET_KEY=
DOCUMENT_STORE_OBJECT_KMS_KEY_ID=replace-with-managed-object-key-id
DOCUMENT_STORE_OBJECT_PATH_STYLE=false
DOCUMENT_STORE_RECONCILIATION_ENABLED=true
DOCUMENT_STORE_RECONCILIATION_RUN_ON_STARTUP=false
DOCUMENT_STORE_RECONCILIATION_BATCH_SIZE=50
DOCUMENT_STORE_RECONCILIATION_MINIMUM_AGE_SECONDS=300
DOCUMENT_STORE_RECONCILIATION_INITIAL_DELAY_MS=60000
DOCUMENT_STORE_RECONCILIATION_FIXED_DELAY_MS=300000
DOCUMENT_STORE_CLAMAV_HOST=clamav
DOCUMENT_STORE_CLAMAV_PORT=3310
DOCUMENT_STORE_CLAMAV_CONNECT_TIMEOUT_MS=2000
DOCUMENT_STORE_CLAMAV_READ_TIMEOUT_MS=30000
DOCUMENT_STORE_CLAMAV_MAXIMUM_SIGNATURE_AGE_HOURS=48
DOCUMENT_STORE_UPLOAD_MAXIMUM_FAMILIES=100
DOCUMENT_STORE_UPLOAD_MAXIMUM_VERSIONS_PER_FAMILY=20
DOCUMENT_STORE_UPLOAD_MAXIMUM_ORIGINAL_BYTES=524288000
DOCUMENT_STORE_UPLOAD_MAXIMUM_ATTEMPTS_PER_WINDOW=20
DOCUMENT_STORE_UPLOAD_RATE_WINDOW_SECONDS=60
DOCUMENT_STORE_UPLOAD_MAXIMUM_PDF_PAGES=100
DOCUMENT_STORE_UPLOAD_MAXIMUM_EXTRACTED_CHARACTERS=1000000
DOCUMENT_STORE_UPLOAD_EXTRACTION_TIMEOUT_SECONDS=15
DOCUMENT_STORE_UPLOAD_CLEANUP_ENABLED=true
DOCUMENT_STORE_UPLOAD_CLEANUP_MINIMUM_AGE_SECONDS=300
DOCUMENT_STORE_UPLOAD_CLEANUP_FIXED_DELAY_MS=300000
DOCUMENT_STORE_UPLOAD_CLEANUP_BATCH_SIZE=50
DOCUMENT_STORE_RETENTION_ADMIN_TOKEN=replace-via-secret-injection
DOCUMENT_STORE_PURGE_ENABLED=false
DOCUMENT_STORE_PERMANENT_ERASURE_ENABLED=false
DOCUMENT_STORE_PERMANENT_ERASURE_WRITE_FENCE_ENABLED=false
DOCUMENT_STORE_VERSIONED_OBJECT_ERASURE_ENABLED=false
DOCUMENT_STORE_MAXIMUM_BACKUP_RETENTION_DAYS=35
DOCUMENT_STORE_BACKUP_RETENTION_POLICY_VERSION=UNAPPROVED
DOCUMENT_STORE_PERMANENT_ERASURE_BATCH_SIZE=10
DOCUMENT_STORE_PERMANENT_ERASURE_FIXED_DELAY_MS=300000
DOCUMENT_STORE_ERASURE_FINGERPRINT_KEY=replace-with-distinct-32-character-secret
DOCUMENT_STORE_ERASURE_FINGERPRINT_PREVIOUS_KEYS=
DOCUMENT_STORE_ERASURE_JOURNAL_PROVIDER=disabled
DOCUMENT_STORE_ERASURE_JOURNAL_FILESYSTEM_ROOT=
DOCUMENT_STORE_ERASURE_JOURNAL_OBJECT_LOCK_ENABLED=false
DOCUMENT_STORE_ERASURE_JOURNAL_RETENTION_POLICY_VERSION=UNAPPROVED
DOCUMENT_STORE_ERASURE_JOURNAL_CREDENTIALS_PROVIDER=static
DOCUMENT_STORE_ERASURE_JOURNAL_ENDPOINT=
DOCUMENT_STORE_ERASURE_JOURNAL_REGION=
DOCUMENT_STORE_ERASURE_JOURNAL_BUCKET=
DOCUMENT_STORE_ERASURE_JOURNAL_ACCESS_KEY=
DOCUMENT_STORE_ERASURE_JOURNAL_SECRET_KEY=
DOCUMENT_STORE_ERASURE_JOURNAL_KMS_KEY_ID=
DOCUMENT_STORE_ERASURE_JOURNAL_PATH_STYLE_ACCESS=false
DOCUMENT_STORE_RETENTION_MAINTENANCE_ENABLED=false
DOCUMENT_STORE_RECOVERY_DAYS=30
DOCUMENT_STORE_COMPLETED_OPERATION_RETENTION_DAYS=90
DOCUMENT_STORE_LIFECYCLE_AUDIT_DAYS=365
DOCUMENT_STORE_RETENTION_BATCH_SIZE=50
DOCUMENT_STORE_RETENTION_FIXED_DELAY_MS=86400000
DOCUMENT_STORE_RETENTION_POLICY_VERSION=UNAPPROVED
