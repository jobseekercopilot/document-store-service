# Production values are supplied by the approved secret and infrastructure
# boundary. Never commit real credentials, document content, keys or tokens.
DOCUMENT_STORE_DATABASE_URL=jdbc:postgresql://database.example:5432/document_store
DOCUMENT_STORE_DATABASE_USERNAME=document_store
DOCUMENT_STORE_DATABASE_PASSWORD=replace-via-secret-injection
DOCUMENT_STORE_DATABASE_SSL_MODE=verify-full
DOCUMENT_STORE_ENCRYPTION_AT_REST_ENABLED=true
DOCUMENT_STORE_ENCRYPTION_KEY_REFERENCE=kms://replace-with-managed-database-key-reference
DOCUMENT_STORE_BACKUP_ENCRYPTION_ENABLED=true
DOCUMENT_STORE_BACKUP_KEY_REFERENCE=kms://replace-with-managed-backup-key-reference
DOCUMENT_STORE_OBJECT_PROVIDER=s3
# Leave endpoint unset for AWS S3; use an HTTPS URL for an approved compatible service.
DOCUMENT_STORE_OBJECT_ENDPOINT=
DOCUMENT_STORE_OBJECT_REGION=eu-west-2
DOCUMENT_STORE_OBJECT_BUCKET=job-seeker-copilot-documents
DOCUMENT_STORE_OBJECT_ACCESS_KEY=replace-via-secret-injection
DOCUMENT_STORE_OBJECT_SECRET_KEY=replace-via-secret-injection
DOCUMENT_STORE_OBJECT_KMS_KEY_ID=replace-with-managed-object-key-id
DOCUMENT_STORE_OBJECT_PATH_STYLE=false
